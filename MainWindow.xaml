<Window x:Class="FileLockHolder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="File Lock Holder" Height="640" Width="720" MinHeight="560" MinWidth="620"
        WindowStartupLocation="CenterScreen" Closing="Window_Closing">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. 파일 위치 -->
        <GroupBox Grid.Row="0" Header="파일 위치 (드래그 앤 드롭 가능)">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBox x:Name="txtPath" Grid.Column="0" Height="26" AllowDrop="True"
                         PreviewDragOver="txtPath_PreviewDragOver" Drop="txtPath_Drop"
                         TextChanged="txtPath_TextChanged"/>
                <Button x:Name="btnBrowse" Grid.Column="1" Content="찾아보기..." Click="btnBrowse_Click"/>
                <Button x:Name="btnMesPath" Grid.Column="2" Content="현재 시간대 MES 로그"
                        ToolTip="D:\APInovationLog\MES\LOG\yyyy\MM\dd\yyyyMMddHH.txt"
                        Click="btnMesPath_Click"/>
                <TextBlock x:Name="lblFileInfo" Grid.Row="1" Grid.ColumnSpan="3" Margin="2,4,0,0"
                           Foreground="Gray" FontSize="11"/>
            </Grid>
        </GroupBox>

        <!-- 2. 잠금 설정 -->
        <GroupBox Grid.Row="1" Header="잠금 설정">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="유지 시간" VerticalAlignment="Center"/>
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                    <TextBox x:Name="txtSeconds" Width="70" Height="26" Text="5" HorizontalContentAlignment="Right"/>
                    <TextBlock Text=" 초" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button Content="0.5" Tag="0.5" Click="Preset_Click" MinWidth="40"/>
                    <Button Content="1" Tag="1" Click="Preset_Click" MinWidth="40"/>
                    <Button Content="3" Tag="3" Click="Preset_Click" MinWidth="40"/>
                    <Button Content="5" Tag="5" Click="Preset_Click" MinWidth="40"/>
                    <Button Content="10" Tag="10" Click="Preset_Click" MinWidth="40"/>
                    <CheckBox x:Name="chkInfinite" Content="수동 해제까지 계속 유지" VerticalAlignment="Center"
                              Margin="12,0,0,0" Checked="chkInfinite_Changed" Unchecked="chkInfinite_Changed"/>
                </StackPanel>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="공유 모드" VerticalAlignment="Center" Margin="0,8,0,0"/>
                <ComboBox x:Name="cmbShare" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" Height="26" SelectedIndex="0">
                    <ComboBoxItem Tag="Read" Content="읽기만 공유 (FileShare.Read) - MES 의 File.ReadAllLines 재현 / 다른 쪽 쓰기 차단"/>
                    <ComboBoxItem Tag="None" Content="공유 안 함 (FileShare.None) - 완전 독점 / 다른 쪽 읽기·쓰기 모두 차단"/>
                    <ComboBoxItem Tag="ReadWrite" Content="읽기/쓰기 공유 (FileShare.ReadWrite) - 차단 안 됨 (비교용)"/>
                </ComboBox>
            </Grid>
        </GroupBox>

        <!-- 3. 실행 / 상태 -->
        <GroupBox Grid.Row="2" Header="실행 / 상태">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="btnStart" Content="▶ 잠금 시작" Click="btnStart_Click" MinWidth="100" Margin="0"/>
                    <Button x:Name="btnRelease" Content="■ 즉시 해제" Click="btnRelease_Click" MinWidth="100" IsEnabled="False"/>
                    <Button x:Name="btnWriteTest" Content="쓰기 열기 테스트" Click="btnWriteTest_Click" MinWidth="110"
                            ToolTip="쓰기 모드(Append/Write/ReadWrite 공유)로 열어보기만 하고 바로 닫습니다. 내용은 쓰지 않습니다."/>
                </StackPanel>

                <Border Margin="0,10,0,0" Padding="10" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4" Background="#FAFAFA">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Ellipse x:Name="ledStatus" Grid.Column="0" Width="22" Height="22" Fill="Gray" Margin="0,0,10,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="lblStatus" Text="대기 중" FontSize="16" FontWeight="Bold"/>
                            <TextBlock x:Name="lblStatusDetail" Text="파일을 잡고 있지 않습니다." Foreground="Gray"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <TextBlock x:Name="lblElapsed" Text="0.000 초" FontSize="22" FontFamily="Consolas"
                                       FontWeight="Bold" HorizontalAlignment="Right"/>
                            <TextBlock x:Name="lblRemain" Text="" Foreground="Gray" HorizontalAlignment="Right"
                                       FontFamily="Consolas"/>
                        </StackPanel>

                        <ProgressBar x:Name="progress" Grid.Row="1" Grid.ColumnSpan="3" Height="14" Margin="0,10,0,0"
                                     Minimum="0" Maximum="1" Value="0"/>
                    </Grid>
                </Border>
            </StackPanel>
        </GroupBox>

        <!-- 4. 로그 헤더 -->
        <DockPanel Grid.Row="3" Margin="2,0,0,4">
            <Button DockPanel.Dock="Right" Content="로그 지우기" Click="btnClearLog_Click"/>
            <Button DockPanel.Dock="Right" Content="로그 복사" Click="btnCopyLog_Click"/>
            <TextBlock Text="이벤트 로그" FontWeight="Bold" VerticalAlignment="Center"/>
        </DockPanel>

        <!-- 5. 로그 -->
        <ListBox x:Name="lstLog" Grid.Row="4" FontFamily="Consolas" FontSize="12"/>
    </Grid>
</Window>
